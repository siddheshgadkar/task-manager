# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit actual credentials.
# Get these from the Supabase dashboard: Settings -> Database -> Connection string (Session pooler).

SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
